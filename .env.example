# Copy to .env.local for local development. Keep real secrets out of Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Enable only after migration, SMTP, privacy contact and integration QA.
CAMPUSBRIDGE_ACCOUNTS_ENABLED=false
SUPPORT_EMAIL=
# Configure Supabase custom SMTP separately with the same sending provider.
RESEND_API_KEY=
VERIFICATION_FROM=CampusBridge <verify@your-purchased-domain>
# Generate at least 32 random bytes and store only in secure environment settings.
VERIFICATION_SECRET=

# Public browser key: restrict HTTP referrers and allowed Google APIs in Google Cloud.
# Both are embedded at build time; redeploy after changes. Never commit actual values.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Enable only after Places UI Kit activation and website-key restriction are approved.
NEXT_PUBLIC_GOOGLE_REVIEWS_ENABLED=false
