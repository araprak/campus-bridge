{
  "name": "campusbridge",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "description": "CampusBridge personalized first 30 days navigator for new UTD students.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "check:releases": "node scripts/check-releases.mjs",
    "prebuild": "npm run check:releases",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "seed:generate": "node scripts/seed-catalog.mjs",
    "check:isolation": "node scripts/check-group-isolation.mjs --start",
    "check:hosts": "node scripts/check-host-versions.mjs",
    "check:intake": "node scripts/check-intake-sources.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vis.gl/react-google-maps": "1.10.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/google.maps": "3.66.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "7.0.2"
  }
}
